# @tailwindcss/vite declares peer vite ^5.2.0 || ^6, and this project runs
# vite 8. The combination works — the build passes — but the plugin's peer
# range simply has not caught up.
#
# npm 11 resolves this on its own; npm 10, which is what the deploy runs,
# refuses it with ERESOLVE. Without this file the lockfile installs locally
# and fails in CI, which is the worst of both.
legacy-peer-deps=true
